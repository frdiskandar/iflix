# Port the Go server listens on (Dockerfile EXPOSEs 8080).
PORT=8080

# Third-party content API base URL. Empty = built-in default
# (https://z2.idlixku.com/api). Override for staging/mock:
# UPSTREAM_BASE_URL=http://mock:9000/api
UPSTREAM_BASE_URL=

# Watch-together pub/sub. Empty = in-process local mode (single replica).
# For multi-replica / compose: amqp://guest:guest@rabbitmq:5672/
RABBITMQ_URL=
# Redis cache. Empty = in-memory map. Compose example:
# REDIS_ADDR=redis:6379
REDIS_ADDR=
REDIS_PASSWORD=
REDIS_DB=

# Local fallback video served at /default-video.mp4.
# Default: backend/default-video.mp4 next to the binary.
DEFAULT_VIDEO_PATH=

# Comma-separated allowed browser origins for CORS.
# Default: http://localhost:5173,http://localhost:4173
# Compose/prod example: http://localhost,http://localhost:8080
FRONTEND_ORIGIN=
