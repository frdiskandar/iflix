# Root env template for docker compose.
# Copy to `.env` and adjust: `cp .env.example .env`
# Backend reads these at runtime; frontend VITE_* values are
# baked in at image build time (see frontend/Dockerfile ARGs).

# ---------- backend (runtime) ----------
# Port published on the host. Frontend nginx proxies to backend:8080
# internally, so change this only if 8080 clashes locally.
PORT=8080

# Third-party content API. Empty = built-in default.
UPSTREAM_BASE_URL=

# Single replica: leave empty for in-process rooms + in-memory cache.
# Multi-replica: point at the compose services below.
RABBITMQ_URL=
REDIS_ADDR=
REDIS_PASSWORD=
REDIS_DB=

DEFAULT_VIDEO_PATH=
# Browser origin(s) allowed by CORS, comma-separated.
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:4173

# ---------- frontend (build time) ----------
# Same-origin paths via nginx proxy (recommended: works on
# localhost, 127.0.0.1, and LAN without extra CORS).
VITE_API_BASE_URL=/api/upstream
# Empty = same-origin /ws. Set only for exotic setups,
# e.g. VITE_WS_BASE_URL=ws://localhost:8080
VITE_WS_BASE_URL=

# ---------- compose services ----------
RABBITMQ_IMAGE=rabbitmq:3-management
REDIS_IMAGE=redis:7-alpine
