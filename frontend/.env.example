# Same-origin proxy path served by the Go backend (see backend/internal/upstream).
# For Vite dev, server.proxy forwards it to http://localhost:8080.
VITE_API_BASE_URL=/api/upstream
# Watch-together socket: empty = same-origin /ws (recommended: works on
# localhost, 127.0.0.1, and LAN devices via the Vite proxy). Set only for
# exotic setups, e.g. VITE_WS_BASE_URL=ws://localhost:8080
VITE_WS_BASE_URL=
